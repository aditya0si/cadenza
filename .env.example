# ---------------------------------------------------------------------------
# CADENZA — canonical environment file (copy to `.env` in the repo root).
#
#   cp .env.example .env          # server reads <repo>/.env or server/.env
#   cp client/.env.example client/.env   # only needed to override Vite defaults
#
# Every value below has a working default for local development except the
# Clerk keys: with AUTH_MODE=demo the app boots and is fully testable without
# any Clerk account or MongoDB instance.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- database --------------------------------------------------------------
# A local mongod (docker-compose.dev.yml) or a MongoDB Atlas connection string.
MONGO_URI=mongodb://127.0.0.1:27017/cadenza

# --- auth ------------------------------------------------------------------
# `clerk` = real Clerk session tokens (production path).
# `demo`  = locally-signed demo sessions issued by POST /api/auth/demo-session,
#           for local preview when no Clerk keys exist. Loudly labelled in the UI.
AUTH_MODE=demo

# Clerk credentials (required when AUTH_MODE=clerk)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Comma-separated emails that are granted the `admin` role when their user row
# is created or updated (applies to Clerk-synced users and demo sessions alike).
ADMIN_EMAILS=admin@cadenza.dev

# --- media -----------------------------------------------------------------
# Directory that holds the generated royalty-free audio library.
MEDIA_DIR=./media
# HMAC key used to sign short-lived audio stream URLs (single purpose token).
MEDIA_SIGNING_SECRET=dev-only-media-signing-secret-change-me
# Lifetime of an issued stream URL, seconds.
MEDIA_URL_TTL_SECONDS=300

# --- web -------------------------------------------------------------------
# Strict CORS allowlist for the API + Socket.IO handshake.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- realtime --------------------------------------------------------------
# A client position that drifts further than this from the server-authoritative
# clock is snapped back.
PLAYBACK_DRIFT_THRESHOLD_MS=750

# --- client (Vite — build-time values, see client/.env.example) ------------
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000
VITE_AUTH_MODE=demo
VITE_CLERK_PUBLISHABLE_KEY=
