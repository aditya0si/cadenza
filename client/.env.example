# CADENZA web client — Vite build-time variables.
# Copy to client/.env only if you need to override the defaults.
#
# Defaults (when these are unset) target a local API on :4000 with demo auth:
#   VITE_API_URL=http://localhost:4000/api
#   VITE_SOCKET_URL=http://localhost:4000
#   VITE_AUTH_MODE=demo

# Base URL of the REST API
VITE_API_URL=http://localhost:4000/api

# Origin of the Socket.IO server
VITE_SOCKET_URL=http://localhost:4000

# `demo` = local preview without Clerk keys (labelled DEMO MODE in the UI)
# `clerk` = real Clerk authentication
VITE_AUTH_MODE=demo

# Clerk publishable key (required when VITE_AUTH_MODE=clerk)
VITE_CLERK_PUBLISHABLE_KEY=
